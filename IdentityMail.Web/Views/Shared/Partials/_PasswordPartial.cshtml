
<div
class="card card-identity p-4"
data-purpose="password-security-section"
>
<div
    class="d-flex align-items-center justify-content-between pb-3 mb-4 border-bottom"
>
    <div class="d-flex align-items-center gap-2">
    <div class="p-2 bg-indigo-50 text-indigo-600 rounded-lg">
        <i class="bi bi-shield-lock-fill fs-5"></i>
    </div>
    <div>
        <h2 class="h5 fw-bold mb-0 text-slate-800">
        Şifre &amp; Güvenlik
        </h2>
        <p class="text-muted small mb-0">
        Hesap güvenliğinizi korumak için düzenli aralıklarla güçlü
        bir şifre belirleyin
        </p>
    </div>
    </div>
</div>
<form data-purpose="change-password-form" method="post" asp-controller="UserProfile" asp-action="UserPasswordSaveChanges">
    <div class="row g-3">
    <!-- Mevcut Şifre -->
    <div class="col-12">
        <label
        class="form-label text-slate-700 fw-semibold text-sm"
        for="currentPassword"
        >Mevcut Şifre <span class="text-danger">*</span></label
        >
        <div class="input-group">
        <span
            class="input-group-text bg-slate-50 text-muted border-end-0"
            ><i class="bi bi-key"></i
        ></span>
        <input
            class="form-control border-start-0 border-end-0"
            id="currentPassword"
            name="CurrentPassword"
            placeholder="••••••••••••"
            required=""
            type="password"
            value="@Model.CurrentPassword"
        />
        <button
            class="btn btn-outline-secondary border-start-0 bg-transparent text-muted"
            onclick="
            togglePasswordVisibility('currentPassword', this)
            "
            title="Şifreyi Göster/Gizle"
            type="button"
        >
            <i class="bi bi-eye"></i>
        </button>
        </div>
    </div>
    <!-- Yeni Şifre -->
    <div class="col-12 col-md-6">
        <label
        class="form-label text-slate-700 fw-semibold text-sm"
        for="newPassword"
        >Yeni Şifre <span class="text-danger">*</span></label
        >
        <div class="input-group">
        <span
            class="input-group-text bg-slate-50 text-muted border-end-0"
            ><i class="bi bi-lock"></i
        ></span>
        <input
            class="form-control border-start-0 border-end-0"
            id="newPassword"
            name="NewPassword"
            placeholder="Yeni şifrenizi giriniz"
            required=""
            type="password"
            value="@Model.NewPassword"
        />
        <button
            class="btn btn-outline-secondary border-start-0 bg-transparent text-muted"
            onclick="togglePasswordVisibility('newPassword', this)"
            title="Şifreyi Göster/Gizle"
            type="button"
        >
            <i class="bi bi-eye"></i>
        </button>
        </div>
    </div>
    <!-- Yeni Şifre Tekrar -->
    <div class="col-12 col-md-6">
        <label
        class="form-label text-slate-700 fw-semibold text-sm"
        for="confirmNewPassword"
        >Yeni Şifre Tekrar <span class="text-danger">*</span></label
        >
        <div class="input-group">
        <span
            class="input-group-text bg-slate-50 text-muted border-end-0"
            ><i class="bi bi-lock-fill"></i
        ></span>
        <input
            class="form-control border-start-0 border-end-0"
            id="confirmNewPassword"
            name="ConfirmPassword"
            placeholder="Yeni şifrenizi doğrulayınız"
            required=""
            type="password"
            value="@Model.ConfirmPassword"
        />
        <button
            class="btn btn-outline-secondary border-start-0 bg-transparent text-muted"
            onclick="
            togglePasswordVisibility('confirmNewPassword', this)
            "
            title="Şifreyi Göster/Gizle"
            type="button"
        >
            <i class="bi bi-eye"></i>
        </button>
        </div>
    </div>
    <!-- Hata Mesajları -->
    <div class="col-12 mt-2">
        <div
        class="p-3 bg-slate-50 rounded-3 border border-slate-100"
        >
            <div asp-validation-summary="All" class="text-danger"></div>
        </div>
    </div>
    </div>
    <!-- Password Action Button -->
    <div
    class="d-flex justify-content-end align-items-center gap-2 mt-4 pt-3 border-top"
    >
    <button
        class="btn btn-idmail-primary px-4 d-inline-flex align-items-center gap-2 shadow-sm"
        type="submit"
    >
        <i class="bi bi-shield-lock me-1"></i> Şifreyi Güncelle
    </button>
    </div>
</form>
</div>