@model List<MessageCategory>
@{
    ViewData["Title"] = "Kategoriler";
}

<div class="container my-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3 class="mb-0">Kategoriler</h3>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
    }

    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width: 60px;">#</th>
                        <th>Kategori Adı</th>
                        <th style="width: 120px;">Durum</th>
                        <th style="width: 160px;">İşlem</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var category in Model)
                    {
                        <tr>
                            <td>@category.Id</td>
                            <td>@category.Name</td>
                            <td>
                                @if (category.IsActive)
                                {
                                    <span class="badge bg-success">Aktif</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Pasif</span>
                                }
                            </td>
                            <td>
                                <form asp-controller="Category" asp-action="ToggleActive"
                                      asp-route-id="@category.Id" method="post" class="d-inline">
                                    <button type="submit"
                                            class="btn btn-sm @(category.IsActive ? "btn-warning" : "btn-success")">
                                        @(category.IsActive ? "Pasif Yap" : "Aktif Et")
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }

                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="4" class="text-center text-muted py-4">
                                Henüz kategori eklenmemiş.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="card-footer bg-white text-end">
            <a asp-controller="Category" asp-action="CreateCategory" class="btn btn-primary">
                <i class="bi bi-plus-lg"></i> Yeni Kategori Ekle
            </a>
        </div>
    </div>
</div>