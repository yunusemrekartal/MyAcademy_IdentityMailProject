@model RegisterDto
@{
    ViewData["Title"] = "Register";
}
<h1>Kayıt Formu</h1>
<form method="post">
    <label asp-for="FirstName">Ad</label>
    <input type="type" asp-for="FirstName" class="form-control"/>
    <br />
    <label asp-for="LastName">Soyad</label>
    <input type="type" asp-for="LastName" class="form-control" />
    <br />
    <label asp-for="Email">E Posta</label>
    <input type="email" asp-for="Email" class="form-control" />
    <br />
    <label asp-for="UserName">Kullanıcı Adı</label>
    <input type="type" asp-for="UserName" class="form-control" />
    <br />
    <label asp-for="Password">Şifre</label>
    <input type="password" asp-for="Password" class="form-control" />
    <br />
    <label asp-for="ConfirmPassword">Şifre Tekrar</label>
    <input type="password" asp-for="ConfirmPassword" class="form-control" />
    <br />
    <span class="text-danger">@Html.ValidationSummary()</span>
    <button class="btn btn-outline-dark">Kayıt Ol</button>
</form>