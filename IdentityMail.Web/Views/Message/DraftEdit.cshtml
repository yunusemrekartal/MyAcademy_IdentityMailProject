@model SendMailDto
@{
    ViewData["Title"] = "SendMail";
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>IdentityMail - Yeni Mail Oluştur</title>
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <!-- Google Fonts: Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&amp;display=swap" rel="stylesheet">
    <style>
            :root {
                --primary-color: #4f46e5;
                --primary-hover: #4338ca;
                --primary-light: #eff4ff;
                --bg-surface: #f8f9ff;
                --text-main: #0f172a;
                --text-muted: #64748b;
                --border-color: #e2e8f0;
                --card-shadow: 0 4px 20px -2px rgba(15, 23, 42, 0.05);
            }

            body {
                font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
                background-color: var(--bg-surface);
                color: var(--text-main);
                /*                 padding: 1.75rem 2rem; */
                min-height: 100vh;
            }

            /* Kart & Konteyner */
            .compose-card {
                background: #ffffff;
                border: 1px solid var(--border-color);
                border-radius: 1rem;
                box-shadow: var(--card-shadow);
                overflow: hidden;
            }

            .card-header-custom {
                padding: 1.25rem 1.75rem;
                background: #ffffff;
                border-bottom: 1px solid var(--border-color);
            }

            .form-label-custom {
                font-size: 0.85rem;
                font-weight: 600;
                color: #334155;
                margin-bottom: 0.4rem;
                display: flex;
                align-items: center;
                gap: 0.4rem;
            }

            .input-group-custom {
                background-color: #ffffff;
                border: 1px solid var(--border-color);
                border-radius: 0.65rem;
                transition: all 0.2s ease;
                display: flex;
                align-items: center;
            }

                .input-group-custom:focus-within {
                    border-color: var(--primary-color);
                    box-shadow: 0 0 0 3px rgba(79, 70, 229, 0.12);
                }

                .input-group-custom .input-icon {
                    padding-left: 0.9rem;
                    padding-right: 0.25rem;
                    color: #94a3b8;
                    font-size: 1rem;
                    display: flex;
                    align-items: center;
                }

                .input-group-custom .form-control {
                    border: none;
                    box-shadow: none;
                    background: transparent;
                    padding: 0.65rem 0.85rem;
                    font-size: 0.925rem;
                    color: var(--text-main);
                }

                    .input-group-custom .form-control:focus {
                        outline: none;
                        box-shadow: none;
                    }

            /* Zengin Metin Düzenleyici Üst Araç Çubuğu (Toolbar) */
            .editor-toolbar {
                background-color: #f8fafc;
                border: 1px solid var(--border-color);
                border-bottom: none;
                border-top-left-radius: 0.65rem;
                border-top-right-radius: 0.65rem;
                padding: 0.5rem 0.75rem;
                display: flex;
                flex-wrap: wrap;
                align-items: center;
                gap: 0.25rem;
            }

            .toolbar-btn {
                background: transparent;
                border: none;
                border-radius: 0.375rem;
                color: #475569;
                width: 32px;
                height: 32px;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                font-size: 0.9rem;
                transition: all 0.15s ease;
                cursor: pointer;
            }

                .toolbar-btn:hover {
                    background-color: #e2e8f0;
                    color: var(--primary-color);
                }

            .toolbar-separator {
                width: 1px;
                height: 20px;
                background-color: #cbd5e1;
                margin: 0 0.25rem;
            }

            .editor-textarea {
                border: 1px solid var(--border-color);
                border-bottom-left-radius: 0.65rem;
                border-bottom-right-radius: 0.65rem;
                padding: 1rem;
                font-size: 0.95rem;
                line-height: 1.6;
                resize: vertical;
                min-height: 280px;
                width: 100%;
                color: var(--text-main);
                background-color: #ffffff;
                transition: all 0.2s ease;
            }

                .editor-textarea:focus {
                    outline: none;
                    border-color: var(--primary-color);
                    box-shadow: 0 0 0 3px rgba(79, 70, 229, 0.12);
                }

            /* Eylemler ve Alt Bar */
            .compose-footer {
                padding: 1.25rem 1.75rem;
                background: #fafafa;
                border-top: 1px solid var(--border-color);
                display: flex;
                align-items: center;
                justify-content: space-between;
                flex-wrap: wrap;
                gap: 1rem;
            }

            .btn-send {
                background-color: var(--primary-color);
                border-color: var(--primary-color);
                color: #ffffff;
                font-weight: 500;
                padding: 0.65rem 1.4rem;
                border-radius: 0.6rem;
                display: inline-flex;
                align-items: center;
                gap: 0.5rem;
                transition: all 0.2s ease;
                box-shadow: 0 4px 12px rgba(79, 70, 229, 0.25);
            }

                .btn-send:hover {
                    background-color: var(--primary-hover);
                    border-color: var(--primary-hover);
                    color: #ffffff;
                    box-shadow: 0 6px 16px rgba(79, 70, 229, 0.35);
                    transform: translateY(-1px);
                }

            .btn-draft {
                background-color: #ffffff;
                border: 1px solid var(--border-color);
                color: #334155;
                font-weight: 500;
                padding: 0.65rem 1.3rem;
                border-radius: 0.6rem;
                display: inline-flex;
                align-items: center;
                gap: 0.5rem;
                transition: all 0.2s ease;
            }

                .btn-draft:hover {
                    background-color: #f1f5f9;
                    color: #0f172a;
                    border-color: #cbd5e1;
                }

            /* Bilgilendirme Rozeti */
            .crypto-badge {
                background-color: #f1f5f9;
                color: #475569;
                border-radius: 2rem;
                padding: 0.35rem 0.85rem;
                font-size: 0.8rem;
                font-weight: 500;
                display: inline-flex;
                align-items: center;
                gap: 0.4rem;
            }

            .quick-pill {
                font-size: 0.775rem;
                padding: 0.25rem 0.65rem;
                background-color: var(--primary-light);
                color: var(--primary-color);
                border-radius: 1rem;
                text-decoration: none;
                font-weight: 500;
                cursor: pointer;
                transition: all 0.15s ease;
            }

                .quick-pill:hover {
                    background-color: #e0e7ff;
                    color: var(--primary-hover);
                }
    </style>
</head>
<body>

    <!-- ASP.NET Core MVC @@RenderBody() İçerik Alanı -->
    <div class="container-fluid p-0">

        <!-- Başlık & Karşılama Alanı (Gelen Kutusu sayfası ile tam uyumlu) -->
        <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
            <div>
                <div class="d-flex align-items-center gap-2 mb-1">
                    <h2 class="h3 fw-bold mb-0 text-slate-900">Taslağı Düzenle ✍️</h2>
                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2.5 py-1 rounded-pill fw-medium" style="font-size: 0.8rem;">
                        <i class="bi bi-shield-check me-1"></i>Uçtan Uca Şifreli
                    </span>
                </div>
                <p class="text-muted mb-0 small">IdentityMail ağı içerisindeki kullanıcılara güvenli ve şifreli iletiler gönderin.</p>
            </div>

            <!-- Bilgilendirici İpucu & Hızlı Kısayol -->
            <div class="d-flex align-items-center gap-3">
                <div class="crypto-badge border">
                    <i class="bi bi-lock-fill text-primary"></i>
                    <span class="">Zero-Knowledge Şifreleme Aktif</span>
                </div>
            </div>
        </div>

        <!-- Form Kartı -->
        <div class="compose-card">

            <!-- Kart Üst Barı -->
            <div class="card-header-custom d-flex justify-content-between align-items-center">
                <div class="d-flex align-items-center gap-2">
                    <span class="p-2 rounded-3 bg-primary-subtle text-primary d-inline-flex align-items-center justify-content-center" style="width: 36px; height: 36px;">
                        <i class="bi bi-envelope-plus fs-5"></i>
                    </span>
                    <div>
                        <h6 class="mb-0 fw-bold">E-Posta Hazırla</h6>
                        <small class="text-muted">Tüm zorunlu alanları eksiksiz doldurunuz</small>
                    </div>
                </div>

        
            </div>

            <!-- Form Gövdesi -->
            <form class="p-4" asp-controller="Message" asp-action="DraftEdit" method="post">
                 <!-- 0. KATEGORİ-->
                <div class="mb-3">
                    <label asp-for="CategoryId" class="form-label-custom">Kategori</label>
                    <select asp-for="CategoryId" asp-items="ViewBag.Categories" class="form-select">
                        <option value="">Kategori seçin (isteğe bağlı)</option>
                    </select>
                    <span asp-validation-for="CategoryId" class="text-danger"></span>
                </div>
                <!-- 1. ALICI MAİL -->
                <div class="mb-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <label for="recipientEmail" class="form-label-custom">
                            <i class="bi bi-person-at text-primary"></i> Alıcı E-Posta Adresi
                        </label>
                        <span class="text-muted small" style="font-size: 0.775rem;">Örn: kullanici@identitymail.com</span>
                    </div>
                    <div class="input-group-custom">
                        <div class="input-icon">
                            <i class="bi bi-at"></i>
                        </div>
                        <input type="email" class="form-control" id="recipientEmail" placeholder="Mesajı göndermek istediğiniz e-posta adresini girin..." required="" name="ReceiverMail" value="@Model.ReceiverMail">
                    </div>
                </div>

                <!-- 2. KONU -->
                <div class="mb-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <label for="mailSubject" class="form-label-custom">
                            <i class="bi bi-chat-left-dots text-primary"></i> Mesaj Konusu
                        </label>
                        <span class="text-muted small" style="font-size: 0.775rem;">Konu başlığı alıcı gelen kutusunda öne çıkar</span>
                    </div>
                    <div class="input-group-custom">
                        <div class="input-icon">
                            <i class="bi bi-type-h1"></i>
                        </div>
                        <input type="text" class="form-control" id="mailSubject" placeholder="İletinizin konusunu yazınız (Örn: Proje Sprint Değerlendirmesi)..." required="" name="Subject" value="@Model.Subject">
                    </div>
                </div>

                <!-- 3. MAİL İÇERİĞİ -->
                <div class="mb-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <label for="mailContent" class="form-label-custom">
                            <i class="bi bi-file-earmark-text text-primary"></i> Mesaj İçeriği
                        </label>

                    </div>

                    <!-- Metin Düzenleme Araç Çubuğu (Rich Formatting Bar) -->
                    <!-- Textarea / Mesaj Gövdesi -->
                    <textarea class="form-control" id="mailContent" rows="10" placeholder="İletinizi buraya yazabilirsiniz. Merhaba, ..." required="" style="border-color: var(--border-color); font-size: 0.95rem; line-height: 1.6; resize: vertical;" name="Body">@Model.Body</textarea>
                </div>

                <!-- Dosya Ekleme & Güvenlik Göstergesi -->
                <!-- Alt Bar: Butonlar (Mail Gönder & Taslağa Kaydet) -->
                <div class="compose-footer">
                    <!-- Sol taraf ikincil aksiyon / temizleme -->
                    <div class="d-flex align-items-center gap-2">
                        <a class="btn btn-outline-danger btn-sm rounded-pill px-3 d-inline-flex align-items-center gap-1" href="/Message/Draft">
                            <i class="bi bi-trash"></i> Vazgeç
                        </a>
                    </div>

                    <!-- Sağ taraf ana aksiyon butonları: Taslağa Kaydet & Mail Gönder -->
                    <div class="d-flex align-items-center gap-3">

                        <!-- Buton 1: Taslağa Kaydet -->
                        <button type="submit" class="btn btn-draft" id="btnSaveDraft" name="action" value="draft">
                            <i class="bi bi-file-earmark-arrow-down text-secondary"></i>
                            <span class="">Taslağa Kaydet</span>
                        </button>

                        <!-- Buton 2: Mail Gönder -->
                        <button type="submit" class="btn btn-send" id="btnSendMail" name="action" value="send">
                            <i class="bi bi-send-fill"></i>
                            <span class="">Mail Gönder</span>
                        </button>

                    </div>
                </div>
            </form>

        </div>

    </div>

    <!-- Bootstrap 5 JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>




</body></html>