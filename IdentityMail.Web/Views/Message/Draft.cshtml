@model List<UserMessage>
<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>IdentityMail Taslaklar (@@RenderBody())</title>
  <!-- Bootstrap 5 CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <!-- Bootstrap Icons -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <!-- Google Fonts: Inter -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

  <style>

    /* Tablo ve Kart Tasarımı */
    .table-container {
      background: #ffffff;
      border-radius: 1rem;
      border: 1px solid #e2e8f0;
      box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.02), 0 2px 4px -2px rgba(0, 0, 0, 0.02);
      overflow: hidden;
    }

    .table thead th {
      background-color: #ffffff;
      color: #64748b;
      font-size: 0.75rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      border-bottom: 1px solid #f1f5f9;
      padding: 1.1rem 1.25rem;
      white-space: nowrap;
    }

    .table tbody td {
      padding: 1.15rem 1.25rem;
      vertical-align: middle;
      border-bottom: 1px solid #f8fafc;
      color: #334155;
      font-size: 0.875rem;
    }

    .table tbody tr {
      transition: background-color 0.15s ease-in-out;
    }

    .table tbody tr:hover {
      background-color: #f8fafc;
    }

    .table tbody tr:last-child td {
      border-bottom: none;
    }

    /* İçerik Kısaltma */
    .text-preview {
      display: -webkit-box;
      -webkit-line-clamp: 1;
      -webkit-box-orient: vertical;
      overflow: hidden;
      color: #64748b;
      max-width: 380px;
    }

    /* Kategori Rozetleri */
    .badge-category {
      font-size: 0.75rem;
      font-weight: 500;
      padding: 0.35rem 0.75rem;
      border-radius: 2rem;
    }

    .badge-work { background-color: #e0f2fe; color: #0284c7; }
    .badge-dev { background-color: #eff6ff; color: #3b82f6; }
    .badge-finance { background-color: #ecfdf5; color: #059669; }
    .badge-hr { background-color: #fef3c7; color: #d97706; }
    .badge-system { background-color: #fee2e2; color: #dc2626; }
    .badge-general { background-color: #f1f5f9; color: #475569; }

    /* Aksiyon Link Butonları */
    .btn-action-edit {
      color: #0284c7;
      background-color: #f0f9ff;
      border: 1px solid #bae6fd;
      transition: all 0.2s ease;
      text-decoration: none;
    }
    .btn-action-edit:hover {
      color: #ffffff;
      background-color: #0284c7;
      border-color: #0284c7;
    }

    .btn-action-delete {
      color: #ef4444;
      background-color: #fef2f2;
      border: 1px solid #fecaca;
      transition: all 0.2s ease;
      text-decoration: none;
    }
    .btn-action-delete:hover {
      color: #ffffff;
      background-color: #ef4444;
      border-color: #ef4444;
    }

    .btn-action-send {
      color: #059669;
      background-color: #ecfdf5;
      border: 1px solid #a7f3d0;
      transition: all 0.2s ease;
      text-decoration: none;
    }
    .btn-action-send:hover {
      color: #ffffff;
      background-color: #059669;
      border-color: #059669;
    }

    .btn-sm-action {
      padding: 0.35rem 0.75rem;
      font-size: 0.8125rem;
      font-weight: 500;
      border-radius: 0.5rem;
      display: inline-flex;
      align-items: center;
      gap: 0.35rem;
      white-space: nowrap;
    }
  </style>
</head>
<body>

  <!-- ASP.NET Core MVC @@RenderBody() Alanı -->
  <div class="container-fluid p-0">
    <div class="table-container">
        @if (TempData["MoveToTrashDraftErrorMessage"] != null)
        {
            <div class="alert alert-success">@TempData["MoveToTrashDraftErrorMessage"]</div>
        }
      <div class="table-responsive">
        <table class="table align-middle mb-0">
          <thead>
            <tr>
              <th scope="col" style="min-width: 220px;">KONU</th>
              <th scope="col" style="min-width: 320px;">İÇERİK</th>
              <th scope="col">KATEGORİ</th>
              <th scope="col" style="min-width: 150px;">TARİH</th>
              <th scope="col" class="text-end" style="min-width: 280px;">İŞLEMLER</th>
            </tr>
          </thead>
          <tbody>
            <!-- Taslak  -->
            @foreach(var draft in Model)
            {
                <tr>
                  <td>
                    <span class="fw-semibold text-dark">@draft.Subject</span>
                  </td>
                  <td>
                    <div class="text-preview">@draft.Body</div>
                  </td>
                  <td>
                    <span class="badge badge-category badge-work">@(draft.Category?.Name??"Kategorisiz")</span>
                  </td>
                  <td class="text-secondary small">
                    @draft.SendDate
                  </td>
                  <td class="text-end">
                    <div class="d-inline-flex gap-2 justify-content-end">
                      <!-- Taslağı Güncelle (a tag) -->
                      <a href="/Message/DraftEdit/@draft.Id" class="btn-sm-action btn-action-edit" title="Taslağı Güncelle">
                        <i class="bi bi-pencil-square"></i>
                        <span>Güncelle</span>
                      </a>
                      <!-- Çöp Kutusuna Taşı(a tag) -->
                      <a href="/Message/MoveToTrashDraft/@draft.Id" class="btn-sm-action btn-action-delete" title="Taslağı Sil">
                        <i class="bi bi-trash3"></i>
                        <span>Sil</span>
                      </a>
                    </div>
                  </td>
                </tr>
            }
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- Bootstrap 5 JS Bundle -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
