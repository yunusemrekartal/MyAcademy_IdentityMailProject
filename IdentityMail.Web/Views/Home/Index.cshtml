@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>IdentityMail - Mesajlaşmanın Güvenli ve Sade Yolu</title>
    <!-- Google Fonts: Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <style>
            :root {
              --primary-color: #4F46E5;
              --primary-hover: #4338CA;
              --navy-dark: #0F172A;
              --text-muted: #64748B;
              --bg-light: #F8FAFC;
              --border-subtle: #E2E8F0;
            }

            body {
              font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
              color: var(--navy-dark);
              background-color: #FFFFFF;
              -webkit-font-smoothing: antialiased;
            }

            /* Navbar */
            .navbar {
              background: rgba(255, 255, 255, 0.9);
              backdrop-filter: blur(12px);
              -webkit-backdrop-filter: blur(12px);
              border-bottom: 1px solid var(--border-subtle);
              transition: all 0.2s ease;
            }

            .brand-title {
              font-weight: 700;
              font-size: 1.25rem;
              letter-spacing: -0.02em;
              color: var(--navy-dark);
            }

            .btn-login {
              color: var(--navy-dark);
              border: 1px solid #CBD5E1;
              font-weight: 500;
              font-size: 0.925rem;
              border-radius: 9999px;
              padding: 0.5rem 1.25rem;
              transition: all 0.2s ease;
              text-decoration: none;
            }
            .btn-login:hover {
              background-color: #F1F5F9;
              color: var(--navy-dark);
              border-color: #94A3B8;
            }

            .btn-register-primary {
              background-color: var(--primary-color);
              color: #FFFFFF !important;
              font-weight: 600;
              font-size: 0.925rem;
              border-radius: 9999px;
              padding: 0.5rem 1.35rem;
              border: 1px solid var(--primary-color);
              transition: all 0.2s ease;
              text-decoration: none;
              box-shadow: 0 1px 2px rgba(79, 70, 229, 0.2);
            }
            .btn-register-primary:hover {
              background-color: var(--primary-hover);
              border-color: var(--primary-hover);
              box-shadow: 0 4px 12px rgba(79, 70, 229, 0.3);
              transform: translateY(-1px);
            }

            /* Hero Section */
            .hero-section {
              padding-top: 5rem;
              padding-bottom: 6rem;
              overflow: hidden;
            }

            .hero-badge {
              display: inline-flex;
              align-items: center;
              gap: 0.5rem;
              background-color: #EEF2FF;
              color: var(--primary-color);
              padding: 0.375rem 0.875rem;
              border-radius: 9999px;
              font-size: 0.8125rem;
              font-weight: 600;
              letter-spacing: 0.02em;
              margin-bottom: 1.5rem;
            }

            .hero-title {
              font-size: 3.25rem;
              font-weight: 800;
              line-height: 1.15;
              letter-spacing: -0.035em;
              color: var(--navy-dark);
              margin-bottom: 1.25rem;
            }

            .hero-desc {
              font-size: 1.2rem;
              line-height: 1.6;
              color: var(--text-muted);
              margin-bottom: 2.25rem;
              max-width: 520px;
            }

            .btn-hero-cta {
              background-color: var(--primary-color);
              color: #FFFFFF;
              font-weight: 600;
              font-size: 1.125rem;
              padding: 0.9rem 2.25rem;
              border-radius: 9999px;
              border: none;
              transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
              box-shadow: 0 10px 25px -5px rgba(79, 70, 229, 0.35), 0 8px 10px -6px rgba(79, 70, 229, 0.2);
              display: inline-flex;
              align-items: center;
              gap: 0.6rem;
              text-decoration: none;
            }
            .btn-hero-cta:hover {
              background-color: var(--primary-hover);
              color: #FFFFFF;
              transform: translateY(-2px);
              box-shadow: 0 15px 30px -5px rgba(79, 70, 229, 0.45);
            }

            .hero-img-container {
              position: relative;
              border-radius: 1.75rem;
              padding: 0.5rem;
              background: linear-gradient(180deg, rgba(241, 245, 249, 0.6) 0%, rgba(255, 255, 255, 0) 100%);
            }

            .hero-illustration {
              width: 100%;
              height: auto;
              border-radius: 1.5rem;
              box-shadow: 0 20px 40px -15px rgba(15, 23, 42, 0.08);
              border: 1px solid rgba(226, 232, 240, 0.8);
              display: block;
            }

            /* Features Section */
            .features-section {
              background-color: var(--bg-light);
              padding-top: 6rem;
              padding-bottom: 6.5rem;
              border-top: 1px solid var(--border-subtle);
              border-bottom: 1px solid var(--border-subtle);
            }

            .section-title {
              font-weight: 800;
              font-size: 2.25rem;
              letter-spacing: -0.025em;
              color: var(--navy-dark);
              margin-bottom: 0.75rem;
            }

            .section-subtitle {
              color: var(--text-muted);
              font-size: 1.0625rem;
              margin-bottom: 4rem;
            }

            .feature-card {
              background: #FFFFFF;
              border: 1px solid var(--border-subtle);
              border-radius: 1.25rem;
              padding: 2.5rem 2rem;
              height: 100%;
              transition: all 0.3s ease;
              box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.02), 0 2px 4px -2px rgba(0, 0, 0, 0.02);
            }
            .feature-card:hover {
              transform: translateY(-4px);
              box-shadow: 0 20px 25px -5px rgba(15, 23, 42, 0.06), 0 8px 10px -6px rgba(15, 23, 42, 0.03);
              border-color: #CBD5E1;
            }

            .icon-box {
              width: 56px;
              height: 56px;
              border-radius: 1rem;
              background: #EEF2FF;
              color: var(--primary-color);
              display: flex;
              align-items: center;
              justify-content: center;
              font-size: 1.6rem;
              margin-bottom: 1.5rem;
              transition: background 0.2s ease;
            }
            .feature-card:hover .icon-box {
              background: var(--primary-color);
              color: #FFFFFF;
            }

            .card-title {
              font-size: 1.25rem;
              font-weight: 700;
              letter-spacing: -0.015em;
              color: var(--navy-dark);
              margin-bottom: 0.6rem;
            }

            .card-text {
              color: var(--text-muted);
              font-size: 0.975rem;
              line-height: 1.55;
              margin-bottom: 0;
            }

            /* Footer */
            .site-footer {
              background-color: #FFFFFF;
              padding-top: 3.5rem;
              padding-bottom: 3.5rem;
            }

            .footer-brand {
              font-weight: 700;
              font-size: 1.125rem;
              color: var(--navy-dark);
              display: inline-flex;
              align-items: center;
              gap: 0.5rem;
            }

            .footer-text {
              color: var(--text-muted);
              font-size: 0.925rem;
              margin-top: 0.5rem;
              margin-bottom: 0;
            }

            @@media (max-width: 991.98px) {
              .hero-section {
                padding-top: 3rem;
                padding-bottom: 4rem;
                text-align: center;
              }
              .hero-title {
                font-size: 2.5rem;
              }
              .hero-desc {
                margin-left: auto;
                margin-right: auto;
              }
              .hero-img-container {
                margin-top: 2.5rem;
              }
            }
    </style>
</head>
<body>

    <!-- Üst Navigasyon Barı -->
    <nav class="navbar sticky-top py-3">
        <div class="container d-flex justify-content-between align-items-center">
            <!-- Sol: Logo & Uygulama Adı -->
            <a class="navbar-brand d-flex align-items-center gap-2 m-0 p-0" href="/Home/Index">
                <img src="~/HomePage/home-icon.png" alt="IdentityMail Logo" width="36" height="36" class="rounded-3">
                <span class="brand-title">IdentityMail</span>
            </a>

            <!-- Sağ: Giriş Yap & Kayıt Ol Butonları -->
            <div class="d-flex align-items-center gap-2">
                <a href="/Auth/Login" class="btn btn-login">Giriş Yap</a>
                <a href="/Auth/Register" class="btn btn-register-primary">Kayıt Ol</a>
            </div>
        </div>
    </nav>

    <!-- Hero (Kahraman) Bölümü -->
    <section class="hero-section">
        <div class="container">
            <div class="row align-items-center g-5">
                <!-- Metin ve Çağrı -->
                <div class="col-lg-6">
                    <div class="hero-badge">
                        <i class="bi bi-shield-check"></i>
                        <span>Yeni Nesil İletişim Deneyimi</span>
                    </div>
                    <h1 class="hero-title">Mesajlaşmanın Güvenli ve Sade Yolu</h1>
                    <p class="hero-desc">
                        Kayıtlı kullanıcılar arasında karmaşadan uzak, anlık ve uçtan uca korunan yeni nesil web mesajlaşma deneyimi.
                    </p>
                    <div>
                        <a href="/Auth/Register" class="btn btn-hero-cta">
                            <span>Hemen Kayıt Ol</span>
                            <i class="bi bi-arrow-right"></i>
                        </a>
                    </div>
                </div>

                <!-- Sade İllüstrasyon Bölümü -->
                <div class="col-lg-6">
                    <div class="hero-img-container">
                        <img src="~/HomePage/home-img.png" alt="Güvenli Mesajlaşma İllüstrasyonu" class="hero-illustration">
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Özellikler Bölümü -->
    <section class="features-section">
        <div class="container">
            <div class="text-center">
                <h2 class="section-title">Neler Sunuyoruz</h2>
                <p class="section-subtitle">Gereksiz detaylardan arındırılmış, yalnızca ihtiyacınız olan temel özellikler.</p>
            </div>

            <div class="row g-4">
                <!-- Kart 1: Güvenli Giriş -->
                <div class="col-md-4">
                    <div class="feature-card">
                        <div class="icon-box">
                            <i class="bi bi-shield-lock"></i>
                        </div>
                        <h3 class="card-title">Güvenli Giriş</h3>
                        <p class="card-text">Gelişmiş kimlik doğrulama mimarisi ile hesaplarınız ve konuşmalarınız daima güvende.</p>
                    </div>
                </div>

                <!-- Kart 2: Hızlı Mesajlaşma -->
                <div class="col-md-4">
                    <div class="feature-card">
                        <div class="icon-box">
                            <i class="bi bi-envelope-check"></i>
                        </div>
                        <h3 class="card-title">Hızlı Mesajlaşma</h3>
                        <p class="card-text">Kayıtlı kullanıcılar arasında gecikmesiz, anlık ve akıcı bir e-posta / mesaj akışı.</p>
                    </div>
                </div>

                <!-- Kart 3: Okundu Bilgisi -->
                <div class="col-md-4">
                    <div class="feature-card">
                        <div class="icon-box">
                            <i class="bi bi-check2-all"></i>
                        </div>
                        <h3 class="card-title">Okundu Bilgisi</h3>
                        <p class="card-text">İletinizin alıcıya ulaştığını ve okunduğunu anlık durum onaylarıyla anında takip edin.</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Footer -->
    <footer class="site-footer">
        <div class="container text-center">
            <div class="footer-brand justify-content-center">
                <img src="~/HomePage/home-icon.png" alt="IdentityMail" width="26" height="26" class="rounded-2">
                <span>IdentityMail</span>
            </div>
            <p class="footer-text">
                © 2025 IdentityMail. Sade, güvenli ve modern web mesajlaşma platformu.
            </p>
        </div>
    </footer>

    <!-- Bootstrap 5 JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>